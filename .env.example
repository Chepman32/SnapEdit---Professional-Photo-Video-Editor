# Environment Variables Example
# Copy this file to .env for development

# App Configuration
APP_NAME=SnapEdit
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# Environment
NODE_ENV=development

# API Configuration (if needed in future)
# API_URL=https://api.example.com
# API_KEY=your_api_key_here

# Analytics (if using)
# SENTRY_DSN=your_sentry_dsn
# FIREBASE_CONFIG=your_firebase_config

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_PREMIUM_FEATURES=true

# In-App Purchase Configuration
# IOS_IAP_SHARED_SECRET=your_ios_shared_secret
# ANDROID_IAP_LICENSE_KEY=your_android_license_key

# Social Media (for sharing)
# INSTAGRAM_APP_ID=your_instagram_app_id
# FACEBOOK_APP_ID=your_facebook_app_id

# Storage
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
CACHE_SIZE_LIMIT_MB=1000
